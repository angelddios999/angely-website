---
/**
 * Contact form → POST /api/contact
 * Pass `siteKey` from the page (PUBLIC_TURNSTILE_SITE_KEY).
 */
interface Props {
  siteKey?: string;
}

const siteKey = (Astro.props.siteKey ?? "").trim();
const hasSiteKey = Boolean(siteKey && !siteKey.includes("your-turnstile"));
---

<form
  id="contact-form"
  class="mx-auto max-w-xl space-y-5"
  method="POST"
  action="/api/contact"
  novalidate
>
  <div>
    <label for="name" class="label-field">Name <span class="text-ink-muted">*</span></label>
    <input
      id="name"
      name="name"
      type="text"
      autocomplete="name"
      required
      maxlength="120"
      class="input-field"
      placeholder="Your name"
      aria-describedby="name-error"
    />
    <p id="name-error" class="mt-1 hidden text-sm text-red-800"></p>
  </div>

  <div>
    <label for="email" class="label-field">Email <span class="text-ink-muted">*</span></label>
    <input
      id="email"
      name="email"
      type="email"
      autocomplete="email"
      required
      maxlength="200"
      class="input-field"
      placeholder="you@example.com"
      aria-describedby="email-error"
    />
    <p id="email-error" class="mt-1 hidden text-sm text-red-800"></p>
  </div>

  <div>
    <label for="message" class="label-field">Message <span class="text-ink-muted">*</span></label>
    <textarea
      id="message"
      name="message"
      required
      rows="6"
      maxlength="5000"
      class="input-field resize-y"
      placeholder="Say hello…"
      aria-describedby="message-error"
    ></textarea>
    <p id="message-error" class="mt-1 hidden text-sm text-red-800"></p>
  </div>

  <!-- Cloudflare Turnstile -->
  <div class="space-y-2">
    {
      hasSiteKey ? (
        <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" />
      ) : (
        <div class="rounded-xl border border-dashed border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-950">
          <p class="font-medium">Turnstile is not configured yet</p>
          <p class="mt-1 text-amber-900/80">
            Set <code class="rounded bg-amber-100 px-1">PUBLIC_TURNSTILE_SITE_KEY</code> in
            <code class="rounded bg-amber-100 px-1">.env</code> (local) or as a Worker variable
            (production). See the README.
          </p>
        </div>
      )
    }
  </div>

  <div
    id="form-status"
    class="hidden rounded-xl px-4 py-3 text-sm"
    role="status"
    tabindex="-1"
  >
  </div>

  <button type="submit" id="submit-btn" class="btn-primary w-full sm:w-auto" disabled={!hasSiteKey}>
    Send message
  </button>
</form>

{
  hasSiteKey && (
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  function showStatus(kind: "ok" | "err", message: string) {
    if (!status) return;
    status.classList.remove(
      "hidden",
      "bg-emerald-50",
      "text-emerald-900",
      "bg-red-50",
      "text-red-900",
    );
    if (kind === "ok") {
      status.classList.add("bg-emerald-50", "text-emerald-900");
      status.setAttribute("role", "status");
    } else {
      status.classList.add("bg-red-50", "text-red-900");
      status.setAttribute("role", "alert");
    }
    status.textContent = message;
    status.focus();
  }

  function setFieldError(id: string, message: string) {
    const field = document.getElementById(id);
    const err = document.getElementById(`${id}-error`);
    if (field) {
      field.setAttribute("aria-invalid", message ? "true" : "false");
    }
    if (err) {
      err.textContent = message;
      err.classList.toggle("hidden", !message);
    }
  }

  function clearFieldErrors() {
    setFieldError("name", "");
    setFieldError("email", "");
    setFieldError("message", "");
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const message = String(data.get("message") ?? "").trim();
    const token = String(data.get("cf-turnstile-response") ?? "").trim();

    clearFieldErrors();

    let firstInvalid: string | null = null;
    if (!name) {
      setFieldError("name", "Enter your name.");
      firstInvalid = "name";
    }
    if (!email) {
      setFieldError("email", "Enter your email address.");
      firstInvalid ??= "email";
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setFieldError("email", "Enter a valid email address.");
      firstInvalid ??= "email";
    }
    if (!message) {
      setFieldError("message", "Enter a message.");
      firstInvalid ??= "message";
    }

    if (firstInvalid) {
      showStatus("err", "Please fix the highlighted fields and try again.");
      return;
    }

    if (!token) {
      showStatus("err", "Please complete the Turnstile check before sending.");
      return;
    }

    submitBtn.disabled = true;
    submitBtn.setAttribute("aria-busy", "true");
    submitBtn.textContent = "Sending…";
    status?.classList.add("hidden");

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify({
          name,
          email,
          message,
          turnstileToken: token,
        }),
      });

      const body = (await res.json().catch(() => ({}))) as {
        ok?: boolean;
        error?: string;
      };

      if (!res.ok || !body.ok) {
        showStatus(
          "err",
          body.error || `Something went wrong (${res.status}). Please try again.`,
        );
        // @ts-expect-error turnstile global from Cloudflare script
        if (typeof turnstile !== "undefined") turnstile.reset();
        return;
      }

      showStatus("ok", "Message sent — thank you! I'll get back to you soon.");
      form.reset();
      // @ts-expect-error turnstile global from Cloudflare script
      if (typeof turnstile !== "undefined") turnstile.reset();
    } catch {
      showStatus("err", "Network error — check your connection and try again.");
    } finally {
      submitBtn.disabled = false;
      submitBtn.removeAttribute("aria-busy");
      submitBtn.textContent = "Send message";
    }
  });
</script>
