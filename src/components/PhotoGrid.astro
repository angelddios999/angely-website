---
import { isPair, type Artwork } from "../data/portfolio";
import { mediaUrl } from "../lib/media";
import PlaceholderMedia from "./PlaceholderMedia.astro";

interface Props {
  items: Artwork[];
  /** Enable category filter chips */
  filterable?: boolean;
  /** Slightly denser grid on home */
  compact?: boolean;
}

const { items, filterable = true, compact = false } = Astro.props;
const categories = [...new Set(items.map((i) => i.category))];
---

<section class="photo-grid-root" data-photo-grid>
  {
    filterable && categories.length > 1 && (
      <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="Filter by category">
        <button
          type="button"
          class="filter-chip is-active inline-flex min-h-11 items-center rounded-full border border-ink bg-ink px-4 py-1.5 text-sm font-medium text-canvas-elevated transition"
          data-filter="all"
          aria-pressed="true"
        >
          All
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            class="filter-chip inline-flex min-h-11 items-center rounded-full border border-line bg-canvas-elevated px-4 py-1.5 text-sm font-medium text-ink-muted transition hover:border-ink/25 hover:text-ink"
            data-filter={cat}
            aria-pressed="false"
          >
            {cat}
          </button>
        ))}
      </div>
    )
  }

  <ul
    class:list={[
      "grid gap-4 sm:gap-5",
      compact
        ? "grid-cols-2 md:grid-cols-3"
        : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
    ]}
  >
    {
      items.map((item) => (
        <li data-category={item.category} class="photo-item">
          <button
            type="button"
            id={item.id}
            class="group card-media relative block w-full cursor-zoom-in text-left focus-visible:outline-offset-4"
            data-lightbox-open
            data-id={item.id}
            data-title={item.title}
            data-description={item.description ?? ""}
            data-src={item.placeholder ? "" : mediaUrl(item.key)}
            data-pair-src={!item.placeholder && item.pairKey ? mediaUrl(item.pairKey) : ""}
            data-placeholder={item.placeholder ? "true" : "false"}
            data-hue={item.placeholderHue ?? 30}
            data-meta={[item.category, item.year].filter(Boolean).join(" · ")}
            aria-label={
              isPair(item) ? `View ${item.title}, photo and cartoon` : `View ${item.title}`
            }
          >
            {item.placeholder ? (
              <PlaceholderMedia
                title={item.title}
                hue={item.placeholderHue}
                aspect="square"
              />
            ) : (
              <div class="protect-media relative aspect-square w-full overflow-hidden bg-canvas">
                <img
                  src={mediaUrl(item.key)}
                  alt=""
                  width={800}
                  height={800}
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                  class:list={[
                    "protect-media h-full w-full transition duration-500 group-hover:scale-[1.03]",
                    item.category === "Sculpture" || item.category === "Painting"
                      ? "object-contain"
                      : "object-cover",
                  ]}
                />
              </div>
            )}
            {
              isPair(item) && (
                <span class="pointer-events-none absolute left-3 top-3 z-10 rounded-full bg-ink/80 px-2.5 py-1 text-[10px] font-medium uppercase tracking-wider text-canvas-elevated">
                  Photo + cartoon
                </span>
              )
            }
            <div class="border-t border-line/80 bg-canvas-elevated px-3 py-3">
              <p class="text-sm font-medium text-ink">{item.title}</p>
              <p class="mt-0.5 text-xs text-ink-muted">
                {isPair(item) ? "Photo + cartoon" : item.category}
                {item.year ? ` · ${item.year}` : ""}
              </p>
            </div>
          </button>
        </li>
      ))
    }
  </ul>

  <dialog
    id="lightbox"
    class="m-auto w-[min(100%,76rem)] max-h-[min(100%,90dvh)] overflow-auto rounded-2xl border-0 bg-canvas-elevated p-0 shadow-lift backdrop:bg-ink/70 backdrop:backdrop-blur-sm"
    aria-labelledby="lightbox-title"
  >
    <div class="relative flex max-h-[90dvh] flex-col">
      <button
        type="button"
        id="lightbox-close"
        class="absolute right-3 top-3 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-ink/80 text-canvas-elevated transition hover:bg-ink"
        aria-label="Close"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
      <div id="lightbox-media" class="relative min-h-[12rem] overflow-hidden bg-stone-900">
      </div>
      <div class="border-t border-line px-5 py-4 sm:px-6">
        <p id="lightbox-meta" class="eyebrow"></p>
        <h2 id="lightbox-title" class="mt-1 font-display text-xl font-semibold text-ink sm:text-2xl"></h2>
        <p id="lightbox-desc" class="mt-2 text-sm leading-relaxed text-ink-muted"></p>
        <div class="mt-4 flex flex-wrap gap-2">
          <button type="button" id="lightbox-prev" class="btn-secondary px-4">Previous</button>
          <button type="button" id="lightbox-next" class="btn-secondary px-4">Next</button>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  function initPhotoGrid(root: HTMLElement) {
    const chips = root.querySelectorAll<HTMLButtonElement>(".filter-chip");
    const items = root.querySelectorAll<HTMLElement>(".photo-item");
    const buttons = [...root.querySelectorAll<HTMLElement>("[data-lightbox-open]")];

    function visibleButtons(): HTMLElement[] {
      return buttons.filter((btn) => {
        const li = btn.closest(".photo-item");
        return !li?.classList.contains("hidden");
      });
    }

    function applyFilter(filter: string, persist: boolean) {
      chips.forEach((c) => {
        const active = (c.dataset.filter ?? "all") === filter;
        c.classList.toggle("is-active", active);
        c.classList.toggle("bg-ink", active);
        c.classList.toggle("text-canvas-elevated", active);
        c.classList.toggle("border-ink", active);
        c.classList.toggle("bg-canvas-elevated", !active);
        c.classList.toggle("text-ink-muted", !active);
        c.classList.toggle("border-line", !active);
        c.setAttribute("aria-pressed", String(active));
      });
      items.forEach((item) => {
        const show = filter === "all" || item.dataset.category === filter;
        item.classList.toggle("hidden", !show);
      });
      if (persist) {
        const url = new URL(window.location.href);
        if (filter === "all") url.searchParams.delete("filter");
        else url.searchParams.set("filter", filter);
        history.pushState({ filter }, "", url);
      }
    }

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        applyFilter(chip.dataset.filter ?? "all", true);
      });
    });

    const requested = new URLSearchParams(window.location.search).get("filter");
    if (requested && [...chips].some((c) => c.dataset.filter === requested)) {
      applyFilter(requested, false);
    }

    const dialog = root.querySelector<HTMLDialogElement>("#lightbox");
    const mediaEl = root.querySelector<HTMLElement>("#lightbox-media");
    const titleEl = root.querySelector<HTMLElement>("#lightbox-title");
    const descEl = root.querySelector<HTMLElement>("#lightbox-desc");
    const metaEl = root.querySelector<HTMLElement>("#lightbox-meta");
    const closeBtn = root.querySelector<HTMLButtonElement>("#lightbox-close");
    const prevBtn = root.querySelector<HTMLButtonElement>("#lightbox-prev");
    const nextBtn = root.querySelector<HTMLButtonElement>("#lightbox-next");

    let currentIndex = -1;
    let hashLock = false;

    function setHash(id: string | null) {
      hashLock = true;
      const url = new URL(window.location.href);
      url.hash = id ? id : "";
      history.pushState({ piece: id }, "", url);
      queueMicrotask(() => {
        hashLock = false;
      });
    }

    function close() {
      dialog?.close();
    }

    function esc(value: string): string {
      return value
        .replace(/&/g, "&amp;")
        .replace(/"/g, "&quot;")
        .replace(/</g, "&lt;");
    }

    function openFrom(btn: HTMLElement, persistHash: boolean) {
      if (!dialog || !mediaEl || !titleEl || !descEl || !metaEl) return;
      const vis = visibleButtons();
      currentIndex = vis.indexOf(btn);
      const title = btn.dataset.title ?? "";
      const description = btn.dataset.description ?? "";
      const src = btn.dataset.src ?? "";
      const pairSrc = btn.dataset.pairSrc ?? "";
      const isPlaceholder = btn.dataset.placeholder === "true";
      const hue = Number(btn.dataset.hue ?? 30);
      const meta = btn.dataset.meta ?? "";
      const safeTitle = esc(title);

      titleEl.textContent = title;
      descEl.textContent = description;
      metaEl.textContent = pairSrc ? `${meta}${meta ? " · " : ""}Photo + cartoon` : meta;

      if (prevBtn) prevBtn.disabled = currentIndex <= 0;
      if (nextBtn) nextBtn.disabled = currentIndex < 0 || currentIndex >= vis.length - 1;

      if (isPlaceholder || !src) {
        mediaEl.innerHTML = `
          <div class="relative flex aspect-[4/3] w-full items-end" style="background: linear-gradient(145deg, hsl(${hue} 28% 78%), hsl(${(hue + 50) % 360} 20% 60%))">
            <span class="placeholder-badge">TODO: replace</span>
            <div class="w-full bg-gradient-to-t from-black/40 to-transparent p-6">
              <p class="text-white/90 text-sm">Upload this piece to R2, then set <code class="rounded bg-white/20 px-1">placeholder: false</code> in content.</p>
            </div>
          </div>`;
      } else if (pairSrc) {
        mediaEl.innerHTML = `
          <div class="grid w-full grid-cols-1 bg-canvas sm:grid-cols-2">
            <figure class="flex min-w-0 flex-col">
              <div class="flex h-[min(42dvh,22rem)] items-center justify-center sm:h-[min(52dvh,34rem)]">
                <img src="${esc(pairSrc)}" alt="Photo · ${safeTitle}" draggable="false" class="protect-media max-h-full max-w-full object-contain" />
              </div>
              <figcaption class="border-t border-line bg-canvas-elevated px-3 py-2 text-center text-xs uppercase tracking-wider text-ink-muted">Photo</figcaption>
            </figure>
            <figure class="flex min-w-0 flex-col sm:border-l sm:border-line">
              <div class="flex h-[min(42dvh,22rem)] items-center justify-center sm:h-[min(52dvh,34rem)]">
                <img src="${esc(src)}" alt="Cartoon · ${safeTitle}" draggable="false" class="protect-media max-h-full max-w-full object-contain" />
              </div>
              <figcaption class="border-t border-line bg-canvas-elevated px-3 py-2 text-center text-xs uppercase tracking-wider text-ink-muted">Cartoon</figcaption>
            </figure>
          </div>`;
      } else {
        mediaEl.innerHTML = `
          <img src="${esc(src)}" alt="${safeTitle}" draggable="false" class="protect-media max-h-[65dvh] w-full object-contain" />`;
      }

      document.body.classList.add("lightbox-open");
      if (!dialog.open) dialog.showModal();
      if (persistHash && btn.dataset.id) setHash(btn.dataset.id);
    }

    function step(delta: number) {
      const vis = visibleButtons();
      const next = currentIndex + delta;
      if (next < 0 || next >= vis.length) return;
      const btn = vis[next];
      if (btn) openFrom(btn, true);
    }

    function openFromHash() {
      const id = window.location.hash.replace(/^#/, "");
      if (!id) {
        if (dialog?.open) close();
        return;
      }
      const btn = buttons.find((b) => b.dataset.id === id);
      if (btn) {
        const li = btn.closest(".photo-item") as HTMLElement | null;
        if (li?.classList.contains("hidden")) {
          applyFilter("all", false);
        }
        openFrom(btn, false);
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => openFrom(btn, true));
    });

    closeBtn?.addEventListener("click", close);
    prevBtn?.addEventListener("click", () => step(-1));
    nextBtn?.addEventListener("click", () => step(1));
    dialog?.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });
    dialog?.addEventListener("close", () => {
      document.body.classList.remove("lightbox-open");
      if (mediaEl) mediaEl.innerHTML = "";
      currentIndex = -1;
      if (window.location.hash) setHash(null);
    });

    document.addEventListener("keydown", (e) => {
      if (!dialog?.open) return;
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        step(-1);
      }
      if (e.key === "ArrowRight") {
        e.preventDefault();
        step(1);
      }
    });

    window.addEventListener("popstate", () => {
      if (hashLock) return;
      const filter = new URLSearchParams(window.location.search).get("filter") ?? "all";
      applyFilter(filter, false);
      openFromHash();
    });

    openFromHash();
  }

  document.querySelectorAll<HTMLElement>("[data-photo-grid]").forEach(initPhotoGrid);
</script>
