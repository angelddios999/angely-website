---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="container-page flex min-h-[50dvh] flex-col items-start justify-center py-20">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 font-display text-4xl font-semibold text-ink sm:text-5xl">
      This page wandered off the page.
    </h1>
    <p class="mt-4 max-w-md text-ink-muted">
      The link may be outdated, or the piece may have moved. Try a gallery, or head home.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Back home</a>
      <a href="/physical" class="btn-secondary">Physical art</a>
      <a href="/digital" class="btn-secondary">Digital art</a>
      <a href="/stories" class="btn-secondary">Stories</a>
    </div>
  </section>
</BaseLayout>
