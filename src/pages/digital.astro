---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import { digitalArt } from "../data/portfolio";
---

<BaseLayout
  title="Digital Art"
  description="Digital illustrations and cartoon portraits, including pieces drawn from real photos."
>
  <PageHeader
    eyebrow="Gallery"
    title="Digital art"
    description="Cartoon portraits — some drawn from a real photo. Open a piece to see it larger; photo + cartoon pairs show both."
  />
  <section class="section-y">
    <div class="container-page">
      <PhotoGrid items={digitalArt} />
    </div>
  </section>
</BaseLayout>
