---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import { site } from "../data/site";
import { mediaUrl } from "../lib/media";
import {
  getFeatured,
  galleryHrefFor,
  physicalArt,
  digitalArt,
  stories,
  animations,
  type Artwork,
} from "../data/portfolio";

const { art } = getFeatured();
const featured = art.slice(0, 6);

/** How many hero cards to show: 1 wide + 2 squares */
const HERO_SLOT_COUNT = 3;

type HeroCard = {
  id: string;
  title: string;
  href: string;
  src: string | null;
  placeholder: boolean;
  placeholderHue: number;
};

function toHeroCard(item: Artwork): HeroCard {
  return {
    id: item.id,
    title: item.title,
    href: galleryHrefFor(item),
    src: item.placeholder === true ? null : mediaUrl(item.key),
    placeholder: item.placeholder === true,
    placeholderHue: item.placeholderHue ?? 30,
  };
}

function shuffle<T>(items: T[]): T[] {
  const arr = [...items];
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

const heroPool = art.map(toHeroCard);
const heroInitial = shuffle(heroPool).slice(0, Math.min(HERO_SLOT_COUNT, heroPool.length));
const heroPoolJson = JSON.stringify(heroPool);
---

<BaseLayout title={site.title}>
  <!-- Hero -->
  <section class="border-b border-line/80 bg-gradient-to-b from-accent-soft/40 to-transparent">
    <div class="container-page grid gap-12 py-16 sm:py-20 lg:grid-cols-[1.15fr_0.85fr] lg:items-start lg:py-28">
      <div>
        <p class="eyebrow">Art · Illustration · Stories · Animation</p>
        <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl lg:text-6xl lg:leading-[1.08]">
          Pictures that hold still — and ones that move.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-muted sm:text-lg">
          <!-- TODO: replace intro copy -->
          Welcome to {site.shortName}'s portfolio — physical drawings and paintings,
          digital cartoons (some drawn from real photos), picture-stories, and short
          animations. Explore the work, then get in touch.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/physical" class="btn-primary">Browse physical art</a>
          <a href="/digital" class="btn-secondary">See digital art</a>
          <a href="/stories" class="btn-secondary">Read stories</a>
        </div>
      </div>

      <!-- Featured preview cards — random subset, rotates every 5s -->
      <div
        class="grid grid-cols-2 gap-3 sm:gap-4"
        data-hero-rotator
        data-interval-ms="5000"
        data-pool={heroPoolJson}
        aria-live="polite"
      >
        {
          heroInitial.map((item, i) => (
            <a
              href={item.href}
              data-hero-slot
              data-id={item.id}
              class:list={[
                "card-media protect-media relative block overflow-hidden transition-opacity duration-500 ease-out",
                i === 0 && "col-span-2 aspect-[16/10]",
                i !== 0 && "aspect-square",
              ]}
            >
              <div data-hero-media class="absolute inset-0">
                {item.src ? (
                  <img
                    src={item.src}
                    alt={item.title}
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                    draggable="false"
                    class="protect-media h-full w-full object-cover"
                  />
                ) : (
                  <div
                    class="h-full w-full"
                    style={`background: linear-gradient(145deg, hsl(${item.placeholderHue} 28% 78%), hsl(${(item.placeholderHue + 50) % 360} 20% 60%))`}
                  />
                )}
              </div>
              {item.placeholder && <span data-hero-badge class="placeholder-badge">TODO: replace</span>}
              <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/50 to-transparent p-3 pt-8">
                <p data-hero-title class="text-sm font-medium text-white">{item.title}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    type HeroCard = {
      id: string;
      title: string;
      href: string;
      src: string | null;
      placeholder: boolean;
      placeholderHue: number;
    };

    function shuffle<T>(items: T[]): T[] {
      const arr = [...items];
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function sampleUnique(pool: HeroCard[], count: number, avoid: Set<string>): HeroCard[] {
      if (pool.length === 0) return [];
      const preferred = pool.filter((p) => !avoid.has(p.id));
      const source = preferred.length >= count ? preferred : pool;
      return shuffle(source).slice(0, Math.min(count, source.length));
    }

    function gradientStyle(hue: number): string {
      return `background: linear-gradient(145deg, hsl(${hue} 28% 78%), hsl(${(hue + 50) % 360} 20% 60%))`;
    }

    function preload(src: string | null): Promise<void> {
      if (!src) return Promise.resolve();
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => resolve();
        img.onerror = () => resolve();
        img.src = src;
      });
    }

    function applyCard(slot: HTMLAnchorElement, item: HeroCard) {
      slot.href = item.href;
      slot.dataset.id = item.id;

      const media = slot.querySelector<HTMLElement>("[data-hero-media]");
      if (media) {
        if (item.src) {
          media.innerHTML = `<img src="${item.src}" alt="${item.title.replace(/"/g, "&quot;")}" draggable="false" class="protect-media h-full w-full object-cover" />`;
        } else {
          media.innerHTML = `<div class="h-full w-full" style="${gradientStyle(item.placeholderHue)}"></div>`;
        }
      }

      const title = slot.querySelector<HTMLElement>("[data-hero-title]");
      if (title) title.textContent = item.title;

      let badge = slot.querySelector<HTMLElement>("[data-hero-badge]");
      if (item.placeholder) {
        if (!badge) {
          badge = document.createElement("span");
          badge.dataset.heroBadge = "";
          badge.className = "placeholder-badge";
          badge.textContent = "TODO: replace";
          slot.appendChild(badge);
        }
      } else if (badge) {
        badge.remove();
      }
    }

    function initHeroRotator(root: HTMLElement) {
      let pool: HeroCard[] = [];
      try {
        pool = JSON.parse(root.dataset.pool ?? "[]") as HeroCard[];
      } catch {
        return;
      }

      const slots = [...root.querySelectorAll<HTMLAnchorElement>("[data-hero-slot]")];
      if (pool.length === 0 || slots.length === 0) return;

      // Need more pieces than slots to make rotation meaningful
      if (pool.length <= slots.length) return;

      const intervalMs = Number(root.dataset.intervalMs ?? 5000);
      let currentIds = new Set(slots.map((s) => s.dataset.id ?? "").filter(Boolean));
      let timer: ReturnType<typeof setInterval> | null = null;
      let fading = false;

      async function rotate() {
        if (fading || document.visibilityState === "hidden") return;
        fading = true;

        const next = sampleUnique(pool, slots.length, currentIds);
        await Promise.all(next.map((item) => preload(item.src)));

        for (const slot of slots) {
          slot.style.opacity = "0";
        }

        await new Promise((r) => setTimeout(r, 400));

        next.forEach((item, i) => {
          if (slots[i]) applyCard(slots[i], item);
        });
        currentIds = new Set(next.map((item) => item.id));

        // Force reflow so the fade-in always runs
        void root.offsetWidth;
        for (const slot of slots) {
          slot.style.opacity = "1";
        }

        fading = false;
      }

      function start() {
        if (timer != null) return;
        timer = setInterval(rotate, intervalMs);
      }

      function stop() {
        if (timer == null) return;
        clearInterval(timer);
        timer = null;
      }

      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") stop();
        else start();
      });

      start();
    }

    document.querySelectorAll<HTMLElement>("[data-hero-rotator]").forEach(initHeroRotator);
  </script>

  <!-- Short intro + stats -->
  <section class="section-y border-b border-line">
    <div class="container-page grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <p class="eyebrow">About the work</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">
          Made by hand, refined on screen.
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-muted sm:text-lg">
          <!-- TODO: replace short intro -->
          Sketchbook pages, paintings, digital cartoons, illustrated stories, and
          animation studies — organized so new work can drop in easily.
        </p>
        <a href="/about" class="link-underline mt-5 inline-block text-sm font-medium">
          More about {site.shortName} →
        </a>
      </div>
      <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-1 lg:gap-6">
        <div class="rounded-2xl border border-line bg-canvas-elevated p-4 shadow-soft">
          <dt class="text-xs uppercase tracking-wider text-ink-subtle">Physical</dt>
          <dd class="mt-1 font-display text-3xl font-semibold text-ink">{physicalArt.length}</dd>
        </div>
        <div class="rounded-2xl border border-line bg-canvas-elevated p-4 shadow-soft">
          <dt class="text-xs uppercase tracking-wider text-ink-subtle">Digital</dt>
          <dd class="mt-1 font-display text-3xl font-semibold text-ink">{digitalArt.length}</dd>
        </div>
        <div class="rounded-2xl border border-line bg-canvas-elevated p-4 shadow-soft">
          <dt class="text-xs uppercase tracking-wider text-ink-subtle">Stories</dt>
          <dd class="mt-1 font-display text-3xl font-semibold text-ink">{stories.length}</dd>
        </div>
        <div class="rounded-2xl border border-line bg-canvas-elevated p-4 shadow-soft">
          <dt class="text-xs uppercase tracking-wider text-ink-subtle">Animations</dt>
          <dd class="mt-1 font-display text-3xl font-semibold text-ink">{animations.length}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Featured grid -->
  <section class="section-y">
    <div class="container-page">
      <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 class="mt-2 font-display text-3xl font-semibold text-ink">Featured pieces</h2>
        </div>
        <div class="flex flex-wrap gap-4 text-sm">
          <a href="/physical" class="link-underline">Physical</a>
          <a href="/digital" class="link-underline">Digital</a>
          <a href="/stories" class="link-underline">Stories</a>
          <a href="/animations" class="link-underline">Animations</a>
        </div>
      </div>
      <PhotoGrid items={featured} filterable={false} compact />
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-line bg-ink text-canvas-elevated">
    <div class="container-page flex flex-col items-start justify-between gap-6 py-14 sm:flex-row sm:items-center sm:py-16">
      <div>
        <h2 class="font-display text-2xl font-semibold sm:text-3xl">Have a project in mind?</h2>
        <p class="mt-2 max-w-md text-sm text-white/70 sm:text-base">
          <!-- TODO: replace CTA copy -->
          Commissions, school collabs, or just a friendly note — say hello.
        </p>
      </div>
      <a
        href="/contact"
        class="inline-flex rounded-full bg-canvas-elevated px-5 py-2.5 text-sm font-medium text-ink transition hover:bg-accent-soft"
      >
        Contact
      </a>
    </div>
  </section>
</BaseLayout>
